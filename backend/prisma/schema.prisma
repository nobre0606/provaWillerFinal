// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db` npx prisma migrate dev --name init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  usuarioId Int @id @default(autoincrement())
  nome String
  email String @unique
  senha String
  perfil String @default("SOLICITANTE")
  chamados Chamado[]
}


model Chamado {
  id Int @id @default(autoincrement())
  nome String
  descricao String
  status String   @default("ABERTO")
  prazo DateTime
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  
  usuarioId Int
  tecnicoId Int
  
  usuario Usuario  @relation(fields: [usuarioId], references: [usuarioId])
  tecnico Tecnico @relation(fields: [tecnicoId], references: [tecnicoId])
}

model Tecnico{
tecnicoId Int @id @default(autoincrement())
nome String
email String @unique
senha String

chamado Chamado[]
}